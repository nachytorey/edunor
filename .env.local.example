# Catálogo desde Google Drive (npm run sync:drive). Usá UNA de las dos opciones.

# Opción A — clave de API: la carpeta debe estar compartida como
# "Cualquier persona con el enlace: Lector". Crear la clave en
# Google Cloud Console → APIs y servicios → Credenciales, con la "Google Drive API" habilitada.
GOOGLE_DRIVE_API_KEY=

# Opción B — cuenta de servicio: la carpeta puede quedar privada; se comparte
# con el email de la cuenta (xxx@yyy.iam.gserviceaccount.com) como Lector.
# Pegá el JSON en una línea o indicá la ruta al archivo.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Carpeta raíz del catálogo y cantidad de fotos por modelo
DRIVE_FOLDER_ID=17jFiWFdEk4QG6NqpGCMOKow9uKnT573V
DRIVE_MAX_IMAGES=6
